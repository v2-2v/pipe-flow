#!/usr/bin/env bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR" || exit 1

cleanup() {
    kill "$SERVER_PID" 2>/dev/null || true
    exit 0
}

trap cleanup SIGINT
trap cleanup SIGTERM
trap cleanup EXIT

echo "starting server..."
./build/data-bank > /dev/null 2>&1 &
SERVER_PID=$!
echo "server started with PID $SERVER_PID"

while true; do
    read -e -p "pipe-flow $ " line || exit
    if [ -z "$line" ]; then
        continue
    fi
    echo -e "\n"
    line="$(printf '%s\n' "$line" | sed 's/\(^\|[[:space:]]\)#\([[:space:]]\|$\)/ \\\# /g')"
    ./build/input "$line"

    IFS='|' read -r -a parts <<< "$line"
    rewritten=""
    for i in "${!parts[@]}"; do
        step="${parts[$i]}"
        step="$(printf '%s' "$step" | sed 's/^ *//;s/ *$//')"
        if [ -n "$rewritten" ]; then
            rewritten+=" | "
        fi
        rewritten+="$step | ./build/data-send $i"
    done
    bash -c "$rewritten" > /dev/null
    ./build/data-print
    ./build/data-clear
    echo -e "\n"
done
